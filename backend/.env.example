# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=v1
CORS_ORIGIN=http://localhost:3000
TZ=Asia/Dili

# --- Database ---
DATABASE_URL="postgresql://jofran:jofran@localhost:5432/jofran_dev?schema=public"

# --- Redis (cache, sessions, BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_NAME=jofran_refresh

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/v1/auth/microsoft/callback

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-5-mini
OPENAI_MODEL_REASONING=gpt-5
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe
OPENAI_MODEL_MODERATION=omni-moderation-latest
JOJO_DAILY_MESSAGE_LIMIT=60
JOJO_CONTEXT_WINDOW_TURNS=8

# --- Storage (S3) ---
AWS_REGION=ap-southeast-1
S3_BUCKET_MEDIA=jofran-media-dev
S3_SIGNED_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
